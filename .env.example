# Copy to .env and fill in. Never commit .env.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_EMAIL=you@yourstore.com
ADMIN_PASSWORD=choose-a-strong-password
# Or, instead of ADMIN_PASSWORD, a hash: python -c "from werkzeug.security import generate_password_hash as g; print(g('pw'))"
# ADMIN_PASSWORD_HASH=

STORE_NAME=Nexus
STORE_TAGLINE=Premium laptops, delivered with confidence
CURRENCY_SYMBOL=$
CURRENCY_CODE=USD
SUPPORT_PHONE=
SUPPORT_EMAIL=
WHATSAPP_NUMBER=
ANNOUNCEMENT=Free shipping on qualifying orders
FREE_SHIPPING_THRESHOLD=500
SHIPPING_FEE=15
PROMO_CODES=NEXUS10:10
SITE_URL=https://yourstore.com
COOKIE_SECURE=0  # Change to 1 only behind HTTPS in production
